Subject: [PATCH] build: add the RISC-V generic processor error decoder

Adds --enable-riscv-ns-decode, following the same shape as the existing
vendor decoders (yitian, nvidia, ampere, jaguarmicro).

Generated against rasdaemon v0.8.5. Apply with:

    patch -p1 < 0001-build-add-riscv-ns-decoder.patch

after copying non-standard-riscv.c and non-standard-riscv.h into the
rasdaemon source tree. install-rasdaemon.sh does both.

diff --git a/Makefile.am b/Makefile.am
index 6e2b5c8..e78fa20 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -189,6 +189,10 @@ if WITH_YITIAN_NS_DECODE
    rasdaemon_SOURCES += non-standard-yitian.c
 endif
 
+if WITH_RISCV_NS_DECODE
+   rasdaemon_SOURCES += non-standard-riscv.c
+endif
+
 if WITH_RERI
    rasdaemon_SOURCES += ras-reri-handler.c
 endif
@@ -210,6 +214,7 @@ include_HEADERS += non-standard-hisilicon.h
 include_HEADERS += non-standard-jaguarmicro.h
 include_HEADERS += non-standard-nvidia.h
 include_HEADERS += non-standard-yitian.h
+include_HEADERS += non-standard-riscv.h
 
 include_HEADERS += ras-aer-handler.h
 include_HEADERS += ras-arm-handler.h
diff --git a/configure.ac b/configure.ac
index 9e6ff93..4e05a08 100644
--- a/configure.ac
+++ b/configure.ac
@@ -252,6 +252,16 @@ AS_IF([test "x$enable_yitian_ns_decode" = "xyes" || test "x$enable_all" == "xyes
 AM_CONDITIONAL([WITH_YITIAN_NS_DECODE], [test x$enable_yitian_ns_decode = xyes || test x$enable_all == xyes])
 AM_COND_IF([WITH_YITIAN_NS_DECODE], [USE_YITIAN_NS_DECODE="yes"], [USE_YITIAN_NS_DECODE="no"])
 
+AC_ARG_ENABLE([riscv_ns_decode],
+    AS_HELP_STRING([--enable-riscv-ns-decode], [decode the UEFI processor generic error section (RISC-V RERI via GHES)]))
+
+AS_IF([test "x$enable_riscv_ns_decode" = "xyes" || test "x$enable_all" == "xyes"], [
+  AC_DEFINE(HAVE_RISCV_NS_DECODE,1,"have RISC-V generic processor error decode")
+  AC_SUBST([WITH_RISCV_NS_DECODE])
+])
+AM_CONDITIONAL([WITH_RISCV_NS_DECODE], [test x$enable_riscv_ns_decode = xyes || test x$enable_all == xyes])
+AM_COND_IF([WITH_RISCV_NS_DECODE], [USE_RISCV_NS_DECODE="yes"], [USE_RISCV_NS_DECODE="no"])
+
 AC_ARG_ENABLE([nvidia-ns-decode],
     AS_HELP_STRING([--enable-nvidia-ns-decode], [enable NVIDIA_NS_DECODE events]))
 
@@ -343,6 +353,7 @@ compile time options summary
     OpenBMC unified     : $USE_OPENBMC_UNIFIED_SEL
     CPU fault isolation : $USE_CPU_FAULT_ISOLATION
     YITIAN RAS errors   : $USE_YITIAN_NS_DECODE
+    RISC-V proc errors  : $USE_RISCV_NS_DECODE
     JAGUAR RAS errors   : $USE_JAGUAR_NS_DECODE
     NVIDIA RAS errors   : $USE_NVIDIA_NS_DECODE
     Signal              : $USE_SIGNAL
